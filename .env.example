# ─────────────────────────────────────────────────────────────
# QNA Chinese — biến môi trường / 環境變數
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# 把這個檔案複製成 .env.local，再填入真實數值。
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chỉ dùng ở phía máy chủ (server-only). KHÔNG bao giờ đưa vào client.
# 僅限伺服器端使用，絕對不要放到前端。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL công khai của trang (dùng cho redirect sau khi đăng nhập)
# 網站公開網址（登入後導回用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
